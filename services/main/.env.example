INTERNAL_API_KEY=
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RESPONSE_BYTES=65536
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_REPLAY_WINDOW_SECONDS=300
# [Union]
LIBRARY_SERVICE_API_KEY=
# [REQUIRED]
LIBRARY_SERVICE_URL=
# [Union]
