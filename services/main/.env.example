# =============================================================================
# Application
# =============================================================================
APP_ENV=development
APP_VERSION=0.1.0
SERVICE_NAME=main
DEBUG=true

# =============================================================================
# Database
# =============================================================================
DATABASE_URL=postgresql+asyncpg://ksu:secret@localhost:5432/ksu
DB_SCHEMA=main
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# Authentication & Security
# =============================================================================
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Password reset
PASSWORD_RESET_TOKEN_TTL_HOURS=1
PASSWORD_RESET_RATE_LIMIT_COUNT=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900

# Internal service communication
INTERNAL_API_KEY=change-me-internal-api-key

# =============================================================================
# Redis & Celery
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# Email (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@kisiiuniversity.ac.ke
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@kisiiuniversity.ac.ke
SMTP_FROM_EMAIL=no-reply@kisiiuniversity.ac.ke
SMTP_FROM_NAME=Kisii University

# =============================================================================
# Frontend URLs
# =============================================================================
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3001
FRONTEND_RESEARCH_URL=http://localhost:3002
FRONTEND_LIBRARY_URL=http://localhost:3003
RESEARCH_SERVICE_URL=http://localhost:8001

# =============================================================================
# Notifications
# =============================================================================
SMS_PROVIDER=disabled
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUSH_PROVIDER=disabled
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
FCM_SERVER_KEY=

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003"]

# =============================================================================
# File Uploads
# =============================================================================
UPLOAD_DIR=/app/uploads
MEDIA_URL=/uploads
MAX_UPLOAD_MB=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# =============================================================================
# Social Media APIs (Optional)
# =============================================================================

# Twitter/X
X_API_BASE_URL=https://api.x.com
X_UPLOAD_BASE_URL=https://upload.twitter.com
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=

# Facebook
FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com
FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Instagram (uses Facebook App)
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_CALLBACK_URL=

# LinkedIn
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_VERSION=202603
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
