APP_ENV=development
APP_VERSION=0.1.0
SERVICE_NAME=research

DATABASE_URL=postgresql+asyncpg://ksu_research:REPLACE_RESEARCH_DB_PASSWORD@localhost:5432/ksu_services_db
DB_SCHEMA=research
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_DEFAULT_CONCURRENCY=8
DB_DEFAULT_QUERY_BUDGET=40
DB_ROUTE_BUDGETS=[]
RESEARCH_DB_USER=ksu_research
RESEARCH_DB_PASSWORD=REPLACE_RESEARCH_DB_PASSWORD
READ_REPLICA_ENABLED=false
READ_REPLICA_APPROVED=false
READ_DATABASE_URL=

JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

MAIN_SERVICE_URL=http://localhost:8000
# Inbound key accepted from HERI and other internal callers of Research.
INTERNAL_API_KEY=REPLACE_WITH_STRONG_RESEARCH_INTERNAL_API_KEY
# Outbound key presented by Research when calling Main.
MAIN_SERVICE_API_KEY=REPLACE_WITH_STRONG_MAIN_INTERNAL_API_KEY
REFERENCE_VALIDATION_MODE=strict
REFERENCE_VALIDATION_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/app/logs
EXPORT_DIR=/app/exports

ASK_AI_PROVIDER=gemini
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

CORS_ORIGINS=["http://localhost:3000"]
