APP_ENV=development
APP_VERSION=0.1.0
SERVICE_NAME=research

DATABASE_URL=postgresql+asyncpg://ksu:REPLACE_LOCAL_POSTGRES_PASSWORD@localhost:5432/ksu
DB_SCHEMA=research

JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

MAIN_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=REPLACE_WITH_STRONG_INTERNAL_API_KEY
REFERENCE_VALIDATION_MODE=strict
REFERENCE_VALIDATION_TIMEOUT_SECONDS=5
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/app/logs

CORS_ORIGINS=["http://localhost:3000"]
