# research service environment
#
# 40 variables: 30 settings fields, 14 read by ksu_common, 1 compose-only.
# 3 are REQUIRED (no default) — the service will not start without them.
#
# IMPORTANT: pydantic-settings loads this file onto the Settings object but does
# NOT copy it into os.environ. ksu_common reads some variables with os.getenv, so
# those take their hardcoded default unless the variable is in the real process
# environment. Docker Compose handles this via `env_file:`. Running uvicorn,
# celery, alembic or pytest directly does NOT — export those vars in your shell.
# They are marked 'ksu_common' below.

# ==========================================================================
# Application
# ==========================================================================
# [ksu_common]
#   ALSO read by ksu_common via os.getenv (auth.py:32) — must be in the process env, not only this file
APP_ENV=development
APP_VERSION=0.1.0
LOG_DIR=/app/logs
# [Literal]
LOG_FORMAT=json
LOG_LEVEL=INFO
# [ksu_common]
#   ALSO read by ksu_common via os.getenv (audit.py:83) — must be in the process env, not only this file
SERVICE_NAME=research

# ==========================================================================
# Database
# ==========================================================================
# [REQUIRED]
DATABASE_URL=
# [ksu_common]
#   read only by ksu_common (database.py:216) via os.getenv
DB_DEFAULT_CONCURRENCY=8
# [ksu_common]
#   read only by ksu_common (database.py:217) via os.getenv
DB_DEFAULT_QUERY_BUDGET=40
# [int]
DB_MAX_OVERFLOW=0
# [int]
DB_POOL_SIZE=5
# [ksu_common]
#   read only by ksu_common (database.py:219) via os.getenv
DB_ROUTE_BUDGETS=
DB_SCHEMA=research
# [Union]
READ_DATABASE_URL=
# [bool]
READ_REPLICA_APPROVED=false
# [bool]
READ_REPLICA_ENABLED=false

# ==========================================================================
# Authentication
# ==========================================================================
# [ksu_common]
#   ALSO read by ksu_common via os.getenv (audit.py:255) — must be in the process env, not only this file
JWT_ALGORITHM=RS256
JWT_KEY_ID=
JWT_ISSUER=ksu-auth
JWT_AUDIENCE=ksu-platform
# [REQUIRED | ksu_common]
#   ALSO read by ksu_common via os.getenv (audit.py:247) — must be in the process env, not only this file
JWT_PUBLIC_KEY_B64=

# ==========================================================================
# Service interface
# ==========================================================================
# [REQUIRED]
INTERNAL_API_KEY=
# [Union]
MAIN_SERVICE_API_KEY=
MAIN_SERVICE_URL=http://main:8000

# ==========================================================================
# Redis and Celery
# ==========================================================================
# [Union]
CELERY_BROKER_URL=
#   injected by docker-compose
CELERY_CONCURRENCY=
# [ksu_common]
#   read only by ksu_common (worker_metrics.py:82) via os.getenv
CELERY_QUEUES=
# [Union]
CELERY_RESULT_BACKEND=
# [ksu_common]
#   read only by ksu_common (cache.py:106) via os.getenv
KSU_CACHE_REDIS_FAILURE_MODE=
# [ksu_common]
#   read only by ksu_common (worker_metrics.py:100) via os.getenv
KSU_WORKER_METRICS_HOST=
# [ksu_common]
#   read only by ksu_common (worker_metrics.py:72) via os.getenv
KSU_WORKER_METRICS_PORT=
# [ksu_common]
#   read only by ksu_common (worker_metrics.py:101) via os.getenv
KSU_WORKER_METRICS_REDIS_URL=
# [ksu_common]
#   read only by ksu_common (worker_metrics.py:287) via os.getenv
PROMETHEUS_MULTIPROC_DIR=
# [ksu_common]
#   ALSO read by ksu_common via os.getenv (cache.py:126) — must be in the process env, not only this file
REDIS_URL=redis://localhost:6379/2

# ==========================================================================
# CORS and frontend
# ==========================================================================
# [list]
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003"]

# ==========================================================================
# Uploads and media
# ==========================================================================
EXPORT_DIR=/app/exports

# ==========================================================================
# AI assistant
# ==========================================================================
# [Literal]
ASK_AI_PROVIDER=deterministic
# [Union]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# [float]
GEMINI_TIMEOUT_SECONDS=30.0
# [Union]
GOOGLE_API_KEY=

# ==========================================================================
# Other
# ==========================================================================
REFERENCE_VALIDATION_MODE=warn
# [float]
REFERENCE_VALIDATION_TIMEOUT_SECONDS=5.0
