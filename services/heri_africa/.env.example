APP_ENV=development
APP_VERSION=0.1.0
SERVICE_NAME=heri-africa
DATABASE_URL=postgresql+asyncpg://ksu_heri:REPLACE_HERI_DB_PASSWORD@localhost:5432/ksu_services_db
DB_SCHEMA=heri
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_DEFAULT_CONCURRENCY=8
DB_DEFAULT_QUERY_BUDGET=40
DB_ROUTE_BUDGETS=[{"path_prefix":"/api/v1/heri/analytics","max_concurrency":4,"max_queries":60}]
HERI_DB_USER=ksu_heri
HERI_DB_PASSWORD=REPLACE_HERI_DB_PASSWORD
READ_REPLICA_ENABLED=false
READ_REPLICA_APPROVED=false
READ_DATABASE_URL=
JWT_SECRET_KEY=replace-me
JWT_ALGORITHM=HS256
REDIS_URL=redis://localhost:6379/3
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=/tmp/ksu-heri-logs
UPLOAD_DIR=/tmp/ksu-heri-uploads
MEDIA_URL=/media
PUBLIC_CONTENT_RATE_LIMIT_COUNT=120
PUBLIC_CONTENT_RATE_LIMIT_WINDOW_SECONDS=60
HEALTH_RATE_LIMIT_COUNT=30
HEALTH_RATE_LIMIT_WINDOW_SECONDS=60
