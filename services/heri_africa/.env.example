APP_ENV=development
APP_VERSION=0.1.0
SERVICE_NAME=heri-africa
DATABASE_URL=postgresql+asyncpg://ksu_service_user:password@localhost:5432/ksu_services_db
DB_SCHEMA=heri
JWT_SECRET_KEY=replace-me
JWT_ALGORITHM=HS256
REDIS_URL=redis://localhost:6379/3
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=/tmp/ksu-heri-logs
UPLOAD_DIR=/tmp/ksu-heri-uploads
MEDIA_URL=/media
