APP_ENV=development
APP_VERSION=0.1.0
SERVICE_NAME=library

DATABASE_URL=postgresql+asyncpg://ksu_library:REPLACE_LIBRARY_DB_PASSWORD@localhost:5432/ksu_services_db
DB_SCHEMA=library
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_DEFAULT_CONCURRENCY=8
DB_DEFAULT_QUERY_BUDGET=40
DB_ROUTE_BUDGETS=[{"path_prefix":"/api/v1/search","max_concurrency":4,"max_queries":20},{"path_prefix":"/api/v1/analytics","max_concurrency":4,"max_queries":60}]
LIBRARY_DB_USER=ksu_library
LIBRARY_DB_PASSWORD=REPLACE_LIBRARY_DB_PASSWORD
READ_REPLICA_ENABLED=false
READ_REPLICA_APPROVED=false
READ_DATABASE_URL=

JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256

REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

MAIN_SERVICE_URL=http://localhost:8000
MAIN_SERVICE_API_KEY=REPLACE_WITH_MAIN_SERVICE_API_KEY
INTERNAL_API_KEY=REPLACE_WITH_STRONG_INTERNAL_API_KEY
PUBLIC_CATALOG_RATE_LIMIT_COUNT=60
PUBLIC_CATALOG_RATE_LIMIT_WINDOW_SECONDS=60
HEALTH_RATE_LIMIT_COUNT=30
HEALTH_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/app/logs

CORS_ORIGINS=["http://localhost:3000"]
