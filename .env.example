# School Portal staged-release flags
SCHOOL_PORTAL_ROUTES_ENABLED=true
NEXT_PUBLIC_SCHOOL_PORTAL_ENABLED=true
SCHOOL_PORTAL_EVENTS_ENABLED=true
SCHOOL_PORTAL_WEBSOCKET_FANOUT_ENABLED=true

# School Portal realtime tuning
REALTIME_HEARTBEAT_SECONDS=25
REALTIME_MAX_CONNECTIONS_PER_USER=5
REALTIME_MAX_CONNECTIONS_PER_IP=20
REALTIME_QUEUE_SIZE=100

# Local Compose defaults. Replace all passwords and keys before any shared deployment.
GATEWAY_PORT=8080
MAIN_SERVICE_PORT=8000
RESEARCH_SERVICE_PORT=8001
LIBRARY_SERVICE_PORT=8002
HERI_SERVICE_PORT=8003
PUBLIC_FRONTEND_PORT=3000
ADMIN_FRONTEND_PORT=3001
RESEARCH_FRONTEND_PORT=3002
LIBRARY_FRONTEND_PORT=3003
HERI_FRONTEND_PORT=3004
# Public frontend URLs used by Admin cache revalidation and cross-app links.
NEXT_PUBLIC_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_RESEARCH_FRONTEND_URL=http://localhost:3002
NEXT_PUBLIC_LIBRARY_FRONTEND_URL=http://localhost:3003
NEXT_PUBLIC_HERI_AFRICA_FRONTEND_URL=http://localhost:3004
# Leave blank for local root deployments; set mounted paths in VM deployments.
NEXT_PUBLIC_LIBRARY_FRONTEND_BASE_PATH=
NEXT_PUBLIC_HERI_AFRICA_FRONTEND_BASE_PATH=
POSTGRES_DB=ksu_services_db
POSTGRES_USER=ksu_service_user
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_OR_DEPLOYMENT_SECRET
DATABASE_ADMIN_USER=postgres
DATABASE_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_ADMIN_SECRET
MAIN_DB_USER=ksu_main
MAIN_DB_PASSWORD=REPLACE_WITH_LOCAL_OR_DEPLOYMENT_SECRET
RESEARCH_DB_USER=ksu_research
RESEARCH_DB_PASSWORD=REPLACE_WITH_LOCAL_OR_DEPLOYMENT_SECRET
LIBRARY_DB_USER=ksu_library
LIBRARY_DB_PASSWORD=REPLACE_WITH_LOCAL_OR_DEPLOYMENT_SECRET
HERI_DB_USER=ksu_heri
HERI_DB_PASSWORD=REPLACE_WITH_LOCAL_OR_DEPLOYMENT_SECRET
MAIN_INTERNAL_API_KEY=REPLACE_WITH_STRONG_SECRET
RESEARCH_INTERNAL_API_KEY=REPLACE_WITH_STRONG_SECRET
LIBRARY_INTERNAL_API_KEY=REPLACE_WITH_STRONG_SECRET
# JWT signing uses the RSA key pair; JWT_SECRET_KEY is legacy and unused.
JWT_ALGORITHM=RS256
JWT_ISSUER=ksu-auth
JWT_AUDIENCE=ksu-platform
JWT_KEY_ID=REPLACE_WITH_RSA_KEY_ID
JWT_PRIVATE_KEY_B64=REPLACE_WITH_BASE64_RSA_PRIVATE_KEY
JWT_PUBLIC_KEY_B64=REPLACE_WITH_BASE64_RSA_PUBLIC_KEY
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004"]

# All frontend API requests go through the local gateway.
KSU_MAIN_API_URL=http://gateway
KSU_RESEARCH_API_URL=http://gateway
KSU_LIBRARY_API_URL=http://gateway
KSU_HERI_API_URL=http://gateway
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_MAIN_API_URL=http://localhost:8080
NEXT_PUBLIC_RESEARCH_API_URL=http://localhost:8080
NEXT_PUBLIC_LIBRARY_API_URL=http://localhost:8080
NEXT_PUBLIC_HERI_API_URL=http://localhost:8080/api/v1/heri

# Optional integrations. Supply real values through a secret manager.
ASK_AI_PROVIDER=deterministic
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=rkyegon@kisiiuniversity.ac.ke
SMTP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
SMTP_USE_TLS=true
EMAIL_FROM=rkyegon@kisiiuniversity.ac.ke
SMS_PROVIDER=disabled
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUSH_PROVIDER=disabled
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
FCM_SERVER_KEY=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=
INSTAGRAM_CALLBACK_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=
DIGITAL_PROGRAMMES_URL=https://digital.kisiiuniversity.ac.ke/api

# CI/CD and VM deployment values belong in GitHub Actions secrets/variables.
VM_SSH_PRIVATE_KEY=REPLACE_IN_GITHUB_SECRET_STORE
VM_SSH_HOST=REPLACE_VM_HOST
VM_SSH_PORT=22
VM_SSH_USER=ubuntu
VM_SSH_KNOWN_HOSTS=
GCP_PROJECT=
GCP_REGION=
GCP_AR_REPOSITORY=

# PostgreSQL capacity guard inputs. Dedicated audit workers intentionally use
# one process and one connection; include their four connections in the budget
# before increasing worker replicas or pool sizes.
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_CONNECTION_RESERVE=20
# WAL archiving is opt-in for local development. Production must enable it and
# point POSTGRES_WAL_ARCHIVE_HOST_DIR at independently managed off-site storage.
POSTGRES_ARCHIVE_MODE=off
POSTGRES_ARCHIVE_COMMAND=/bin/sh /usr/local/bin/ksu-archive-wal.sh %p %f
POSTGRES_WAL_ARCHIVE_HOST_DIR=./backups/wal
API_WORKERS=2
API_REPLICAS=1
CELERY_CONCURRENCY=1
CELERY_REPLICAS=1
CELERY_INTEGRATION_CONCURRENCY=2
INTEGRATION_WORKER_REPLICAS=1
AUDIT_CELERY_CONCURRENCY=1
AUDIT_WORKER_REPLICAS=1
AUDIT_DB_POOL_SIZE=1
AUDIT_DB_MAX_OVERFLOW=0
