APP_ENV=dev
APP_VERSION=0.1.0
SERVICE_NAME=main
DEBUG=false

DATABASE_URL=postgresql+asyncpg://ksu:REPLACE_POSTGRES_PASSWORD@postgres:5432/ksu
DB_SCHEMA=main
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

PASSWORD_RESET_TOKEN_TTL_HOURS=1
PASSWORD_RESET_RATE_LIMIT_COUNT=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
API_KEY_RATE_LIMIT_WINDOW_SECONDS=60
ANALYTICS_RATE_LIMIT_COUNT=120
ANALYTICS_RATE_LIMIT_WINDOW_SECONDS=60
NEWSLETTER_RATE_LIMIT_COUNT=10
NEWSLETTER_RATE_LIMIT_WINDOW_SECONDS=300

INTERNAL_API_KEY=REPLACE_WITH_STRONG_INTERNAL_API_KEY

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_SMTP_APP_PASSWORD
SMTP_USE_TLS=true
EMAIL_FROM=REPLACE_FROM_EMAIL
SMTP_FROM_EMAIL=REPLACE_FROM_EMAIL
SMTP_FROM_NAME=REPLACE_FROM_NAME

FRONTEND_BASE_URL=https://REPLACE_PUBLIC_HOST
FRONTEND_ADMIN_URL=https://REPLACE_PUBLIC_HOST/admin
FRONTEND_RESEARCH_URL=https://REPLACE_RESEARCH_HOST
FRONTEND_LIBRARY_URL=https://REPLACE_PUBLIC_HOST/library
RESEARCH_SERVICE_URL=http://research:8001
LIBRARY_SERVICE_URL=http://library:8002

CORS_ORIGINS=["https://REPLACE_PUBLIC_HOST","https://REPLACE_RESEARCH_HOST","https://REPLACE_API_HOST"]

UPLOAD_DIR=/app/uploads
MEDIA_URL=/uploads
MAX_UPLOAD_MB=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

SMS_PROVIDER=disabled
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUSH_PROVIDER=disabled
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
FCM_SERVER_KEY=

X_API_BASE_URL=https://api.x.com
X_UPLOAD_BASE_URL=https://upload.twitter.com
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=
FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com
FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_CALLBACK_URL=
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_VERSION=202603
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/app/logs
