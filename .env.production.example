# Copy to a deployment secret store; do not commit a populated .env.production.
APP_ENV=production
DEBUG=false
POSTGRES_DB=ksu_services_db
POSTGRES_USER=ksu_service_user
POSTGRES_PASSWORD=GENERATE_A_UNIQUE_32_CHARACTER_SECRET
DATABASE_URL=postgresql+asyncpg://ksu_service_user:URL_ENCODED_PASSWORD@postgres:5432/ksu_services_db
REDIS_URL=rediss://:URL_ENCODED_REDIS_PASSWORD@redis:6379/0
JWT_SECRET_KEY=GENERATE_A_UNIQUE_32_CHARACTER_SECRET
# Compose injects these into the receiving/calling services separately.
MAIN_INTERNAL_API_KEY=GENERATE_A_UNIQUE_32_CHARACTER_MAIN_SECRET
RESEARCH_INTERNAL_API_KEY=GENERATE_A_UNIQUE_32_CHARACTER_RESEARCH_SECRET
CORS_ORIGINS=["https://kisiiuniversity.ac.ke"]
SMTP_HOST=smtp.example.edu
SMTP_USERNAME=service-account@example.edu
SMTP_PASSWORD=GENERATE_A_SECRET
EMAIL_FROM=service-account@example.edu
SENTRY_DSN=https://example.invalid/replace
BACKUP_BUCKET=approved-off-server-backup-destination
BACKUP_ENCRYPTION_KEY=GENERATE_A_SECRET
