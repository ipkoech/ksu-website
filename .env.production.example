# Copy to a deployment secret store; do not commit a populated .env.production.
APP_ENV=production
DEBUG=false
POSTGRES_DB=ksu_services_db
POSTGRES_USER=ksu_service_user
POSTGRES_PASSWORD=GENERATE_A_UNIQUE_32_CHARACTER_SECRET
# Used only by scripts/provision-database-ownership.sh for existing volumes;
# keep it in a deployment secret store and do not reuse a service role secret.
DATABASE_ADMIN_USER=postgres
DATABASE_ADMIN_PASSWORD=GENERATE_A_UNIQUE_DATABASE_ADMIN_SECRET
MAIN_DB_USER=ksu_main
MAIN_DB_PASSWORD=GENERATE_A_UNIQUE_32_CHARACTER_MAIN_DB_SECRET
RESEARCH_DB_USER=ksu_research
RESEARCH_DB_PASSWORD=GENERATE_A_UNIQUE_32_CHARACTER_RESEARCH_DB_SECRET
LIBRARY_DB_USER=ksu_library
LIBRARY_DB_PASSWORD=GENERATE_A_UNIQUE_32_CHARACTER_LIBRARY_DB_SECRET
HERI_DB_USER=ksu_heri
HERI_DB_PASSWORD=GENERATE_A_UNIQUE_32_CHARACTER_HERI_DB_SECRET
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_DEFAULT_CONCURRENCY=8
DB_DEFAULT_QUERY_BUDGET=40
DB_ROUTE_BUDGETS=[{"path_prefix":"/api/v1/search","max_concurrency":4,"max_queries":20},{"path_prefix":"/api/v1/analytics","max_concurrency":4,"max_queries":60},{"path_prefix":"/api/v1/ask-ai","max_concurrency":2,"max_queries":20},{"path_prefix":"/api/v1/exports","max_concurrency":2,"max_queries":20}]
API_WORKERS=2
CELERY_CONCURRENCY=1
READ_REPLICA_ENABLED=false
READ_REPLICA_APPROVED=false
READ_DATABASE_URL=
REDIS_URL=rediss://:URL_ENCODED_REDIS_PASSWORD@redis:6379/0
JWT_SECRET_KEY=GENERATE_A_UNIQUE_32_CHARACTER_SECRET
# Compose injects these into the receiving/calling services separately.
MAIN_INTERNAL_API_KEY=GENERATE_A_UNIQUE_32_CHARACTER_MAIN_SECRET
RESEARCH_INTERNAL_API_KEY=GENERATE_A_UNIQUE_32_CHARACTER_RESEARCH_SECRET
CORS_ORIGINS=["https://kisiiuniversity.ac.ke"]
SMTP_HOST=smtp.example.edu
SMTP_USERNAME=service-account@example.edu
SMTP_PASSWORD=GENERATE_A_SECRET
EMAIL_FROM=service-account@example.edu
SENTRY_DSN=https://example.invalid/replace
BACKUP_BUCKET=approved-off-server-backup-destination
BACKUP_ENCRYPTION_KEY=GENERATE_A_SECRET
