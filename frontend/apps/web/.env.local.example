NEXT_PUBLIC_MAIN_API_URL=http://localhost:8080
NEXT_PUBLIC_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_RESEARCH_FRONTEND_URL=http://localhost:3002
NEXT_PUBLIC_LIBRARY_FRONTEND_URL=http://localhost:3003
NEXT_PUBLIC_HERI_AFRICA_FRONTEND_URL=http://localhost:3004

# Service APIs.
#
# Every service is reached through the gateway on 8080 when the app runs on
# the host — the per-service ports (8001 research, 8002 library) are only
# routable from inside the compose network. Without these the clients fall
# back to those internal ports, the calls fail, and the homepage silently
# drops its research spotlight, research statistics, and partner logos.
#
# NEXT_PUBLIC_* is used by the browser; KSU_* is used during server rendering
# and takes precedence there.
NEXT_PUBLIC_RESEARCH_API_URL=http://localhost:8080
KSU_RESEARCH_API_URL=http://localhost:8080
NEXT_PUBLIC_LIBRARY_API_URL=http://localhost:8080
KSU_LIBRARY_API_URL=http://localhost:8080
