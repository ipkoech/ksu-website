{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "@ksu/ui": ["./packages/ui/src"],
      "@ksu/ui/*": ["./packages/ui/src/*"],
      "@ksu/auth": ["./packages/auth/src"],
      "@ksu/auth/*": ["./packages/auth/src/*"],
      "@ksu/api-client": ["./packages/api-client/src"],
      "@ksu/api-client/*": ["./packages/api-client/src/*"]
    }
  },
  "exclude": ["node_modules", "**/node_modules", "**/.next"]
}