  },
  "dependencies": {
    "@tanstack/react-query": "^5.76.0",
    "server-only": "0.0.1"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "next": "^15.5.18"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "typescript": "^5.8.3",
    "next": "15.5.18"
  }
