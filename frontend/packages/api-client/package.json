{
  "name": "@ksu/api-client",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./browser": "./src/browser.ts",
    "./service-urls": "./src/service-urls.ts",
    "./types/admin": "./src/types/admin.ts",
    "./main": "./src/main/index.ts",
    "./research": "./src/research/index.ts",
    "./library": "./src/library/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/admin": "./src/hooks/admin/index.ts",
    "./runtime": {
      "react-server": "./src/server-runtime.ts",
      "default": "./src/browser-runtime.ts"
    },
    "./media": "./src/media.ts",
    "./revalidation": "./src/revalidation.ts",
    "./revalidation-route": "./src/revalidation-route.ts",
    "./transport": "./src/transport.ts"
